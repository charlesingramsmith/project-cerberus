{
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python.exe -m pytest:*)",
      "Bash(.venv/Scripts/python.exe -m streamlit run:*)",
      "Bash(.venv/Scripts/python.exe -m pip install -r requirements.txt)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)"
    ],
    "deny": [
      "Read(./.streamlit/secrets.toml)",
      "Edit(./.streamlit/secrets.toml)"
    ]
  }
}
