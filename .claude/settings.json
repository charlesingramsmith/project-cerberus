{
  "permissions": {
    "allow": [
      "Bash(.venv/Scripts/python.exe -m pytest:*)",
      "Bash(.venv/Scripts/python.exe -m streamlit run:*)",
      "Bash(.venv/Scripts/python.exe -m pip install -r requirements.txt)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(supabase --version)",
      "Bash(supabase --help)"
    ],
    "ask": [
      "Bash(supabase db query:*)",
      "Bash(supabase db push:*)"
    ],
    "deny": [
      "Read(./.streamlit/secrets.toml)",
      "Edit(./.streamlit/secrets.toml)",
      "Read(~/.supabase/**)",
      "Bash(supabase db reset:*)",
      "Bash(supabase login:*)",
      "Bash(supabase link:*)"
    ]
  }
}
